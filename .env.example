# Placeholders only. .env is ignored by Git and Docker build contexts.
# Use a dedicated Supabase project, never the original application's database.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICA
SUPABASE_DB_CONNECTION_STRING="Host=SEU_HOST;Port=5432;Database=postgres;Username=SEU_USUARIO;Password=SUA_SENHA;SSL Mode=VerifyFull;Maximum Pool Size=10"
# Optional alias for .NET/EF tooling; an empty alias never overrides the configured connection.
ConnectionStrings__Default=
DATABASE_PROVIDER=PostgreSQL
RUN_DB_MIGRATIONS=true
# Reserved for future trusted server integrations; not used or required currently.
SUPABASE_SECRET_KEY=

# Compose maps the shared key to API AiCoach__ApiKey and AI EQUILIBRAFIT_AI_API_KEY.
AI_INTERNAL_API_KEY=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
# Local standalone development only. Render uses the published URL in docs/render.md.
AiCoach__BaseUrl=http://localhost:8001
AiCoach__ApiKey=
AiCoach__TimeoutSeconds=75
EQUILIBRAFIT_AI_API_KEY=
EQUILIBRAFIT_AI_OPENAI_API_KEY=
EQUILIBRAFIT_AI_OPENAI_MODEL=gpt-4.1-mini
EQUILIBRAFIT_AI_GEMINI_API_KEY=
EQUILIBRAFIT_AI_GEMINI_MODEL=gemini-2.5-flash
EQUILIBRAFIT_AI_PROVIDER=openai
EQUILIBRAFIT_AI_COACH_PROVIDER=openai
EQUILIBRAFIT_AI_WORKOUTS_PROVIDER=openai
EQUILIBRAFIT_AI_PLANS_PROVIDER=gemini
EQUILIBRAFIT_AI_MEALS_PROVIDER=gemini
EQUILIBRAFIT_AI_MEAL_TEXT_PROVIDER=gemini
EQUILIBRAFIT_AI_LABELS_PROVIDER=gemini
EQUILIBRAFIT_AI_FALLBACK_ENABLED=false
EQUILIBRAFIT_AI_FALLBACK_PROVIDER=gemini
EQUILIBRAFIT_AI_ENVIRONMENT=Development
EQUILIBRAFIT_AI_ENABLE_DOCS=true
EQUILIBRAFIT_AI_LOG_LEVEL=INFO
EQUILIBRAFIT_AI_REQUEST_TIMEOUT_SECONDS=60
EQUILIBRAFIT_AI_YOLO_MODEL_PATH=
EQUILIBRAFIT_AI_DEFAULT_LANGUAGE=pt-BR
EQUILIBRAFIT_AI_AI_MAX_CONTEXT_TOKENS=6000
EQUILIBRAFIT_AI_AI_MAX_RETRIEVED_CHUNKS=4
EQUILIBRAFIT_AI_AI_MAX_OUTPUT_TOKENS=1200
EQUILIBRAFIT_AI_AI_ENABLE_RAG=true
EQUILIBRAFIT_AI_AI_ENABLE_MEMORY=true

ConnectionStrings__Redis=
# Local standalone development only; do not import this value into Render.
AdminApi__BaseUrl=http://localhost:5158
AdminBootstrap__Enabled=false
AdminBootstrap__SupabaseUserId=00000000-0000-0000-0000-000000000000
# Passwords/admin accounts live in Supabase Auth; no AdminBootstrap password or local JWT secret.
# Jwt__Issuer, Jwt__Audience, Jwt__SecretKey and JWT_SECRET_KEY are not used.
Cors__AllowedOrigins__0=http://localhost:8080

# Billing stays disabled until Play Console, ADC credentials, products and RTDN are configured.
GooglePlay__Enabled=false
GOOGLE_PLAY_PACKAGE_NAME=br.com.equilibrafit.app.plusplus
GOOGLE_PLAY_PRODUCT_IDS=
GOOGLE_APPLICATION_CREDENTIALS=
BILLING_TOKEN_ENCRYPTION_KEY=
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# A public, distinct Android applicationId is required for a release; no original Play app is replaced.
EQUILIBRAFIT_PLUSPLUS_APPLICATION_ID=br.com.equilibrafit.app.plusplus
# Optional alternative to ignored android/key.properties; signing secrets stay local.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Dedicated disposable remote test projects only. Never use a production connection.
TEST_POSTGRES_CONNECTION_STRING=
TEST_SUPABASE_DB_CONNECTION_STRING=
