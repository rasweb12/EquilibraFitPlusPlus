@inherits LayoutComponentBase
@inject AdminSessionState Session
@inject AdminApiClient Api
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Surface" Class="admin-appbar">
        @if (Session.IsAuthenticated && Session.IsAdmin)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        }
        <MudText Typo="Typo.h6" Class="admin-brand">EquilibraFit++ Admin</MudText>
        <MudSpacer />
        <MudTooltip Text="Alternar tema">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleTheme" />
        </MudTooltip>
        @if (Session.IsAuthenticated && Session.IsAdmin)
        {
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AccountCircle">
                        @Session.User?.Nome
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOut">Sair</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    @if (Session.IsAuthenticated && Session.IsAdmin)
    {
        <MudDrawer @bind-Open="_drawerOpen"
                   Variant="DrawerVariant.Responsive"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="0"
                   Class="admin-drawer">
            <AdminNavMenu />
        </MudDrawer>
    }

    <MudMainContent Class="admin-main">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Não conseguimos manter a interface ativa agora.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private bool _sessionRestored;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2f8f83",
            Secondary = "#496a9a",
            Tertiary = "#8a6f3d",
            Background = "#f7faf8",
            Surface = "#ffffff",
            AppbarBackground = "#ffffff",
            AppbarText = "#23302d",
            DrawerBackground = "#ffffff",
            DrawerText = "#253331"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#63c7b9",
            Secondary = "#8eb0e3",
            Tertiary = "#d1b875",
            Background = "#111817",
            Surface = "#18211f",
            AppbarBackground = "#18211f",
            AppbarText = "#edf7f4",
            DrawerBackground = "#18211f",
            DrawerText = "#edf7f4"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px"
        }
    };

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionRestored)
        {
            return;
        }

        _sessionRestored = true;
        if (await Session.RestoreAsync(CancellationToken.None))
        {
            StateHasChanged();
        }
    }

    private async Task SignOut()
    {
        await Api.LogoutAsync(CancellationToken.None);
        Navigation.NavigateTo("/login");
    }
}
