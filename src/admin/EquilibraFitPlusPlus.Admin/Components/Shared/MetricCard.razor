<MudPaper Class="pa-4 metric-card" Elevation="0">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudAvatar Color="@Color" Variant="Variant.Filled">
            <MudIcon Icon="@Icon" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Label</MudText>
            <MudText Typo="Typo.h5">@Value</MudText>
        </div>
    </MudStack>
</MudPaper>

@code {
    /// <summary>Metric label.</summary>
    [Parameter]
    public string Label { get; set; } = string.Empty;

    /// <summary>Metric value.</summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>Metric icon.</summary>
    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Analytics;

    /// <summary>Metric color.</summary>
    [Parameter]
    public Color Color { get; set; } = Color.Primary;
}
