@page "/modulos/{Slug}"

<PageTitle>@_module.Title - EquilibraFit++ Admin</PageTitle>

<AuthRequired>
    <PageHeader Title="@_module.Title" Subtitle="@_module.Description">
        <MudButton Href="/" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack">Dashboard</MudButton>
    </PageHeader>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        Este guia reúne rotinas administrativas que já abrem páginas operacionais do painel. Use os atalhos para consultar, editar, auditar e acompanhar indicadores.
    </MudAlert>

    <MudGrid Spacing="3">
        @foreach (ModuleOperation operation in _module.Operations)
        {
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Class="pa-4 status-panel h-100" Elevation="0">
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudIcon Icon="@operation.Icon" Color="@operation.Color" />
                            <MudChip T="string" Color="@operation.Color" Variant="Variant.Outlined">@operation.Status</MudChip>
                        </MudStack>
                        <div>
                            <MudText Typo="Typo.h6">@operation.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@operation.Description</MudText>
                        </div>
                        <MudButton Href="@operation.Href" Variant="Variant.Filled" Color="@operation.Color" StartIcon="@Icons.Material.Filled.OpenInNew">
                            @operation.Action
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 status-panel h-100" Elevation="0">
                <MudText Typo="Typo.h6">Checklist operacional</MudText>
                <MudList T="string" Dense="true">
                    @foreach (string item in _module.Checklist)
                    {
                        <MudListItem Icon="@Icons.Material.Filled.CheckCircle">@item</MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 status-panel h-100" Elevation="0">
                <MudText Typo="Typo.h6">Fluxo recomendado</MudText>
                <MudList T="string" Dense="true">
                    @foreach (string step in _module.Workflow)
                    {
                        <MudListItem Icon="@Icons.Material.Filled.ArrowForward">@step</MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>
</AuthRequired>

