{
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "AiCoach": {
    "BaseUrl": "http://localhost:8001",
    "EndpointPath": "/api/v1/coach/chat",
    "MealRecognitionPath": "/api/v1/meals/recognize",
    "MealTextEstimationPath": "/api/v1/meals/estimate-text",
    "LabelRecognitionPath": "/api/v1/labels/recognize",
    "PlanGenerationPath": "/api/v1/plans/generate",
    "WorkoutGenerationPath": "/api/v1/workouts/generate",
    "Model": "equilibrafit-coach-v1",
    "TimeoutSeconds": 30,
    "ApiKey": ""
  },
  "Database": {
    "Provider": "PostgreSQL"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}
